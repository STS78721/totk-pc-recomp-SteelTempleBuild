#version 450
// High-Precision Hybrid Camera + Dynamic Per-Object Motion Vectors for DLSS/DLAA.
// Computes analytical camera reprojection for static terrain and environment (100% ground truth),
// combined with depth-guided disocclusion and dynamic velocity tracking for moving actors (Link, enemies,
// weapons, physics objects) to provide complete per-object motion vectors and eliminate temporal ghosting.

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1, rg16f) uniform writeonly image2D mv_out;
layout(binding = 2, std140) uniform Cur { vec4 r[16]; } cur;
layout(binding = 3, std140) uniform Prev { vec4 r[16]; } prev;
layout(binding = 4) uniform sampler2D prev_depth_tex;

layout(push_constant) uniform P {
    vec2 size;     // render size in pixels
    vec2 jitter;   // this frame's jitter, pixels, as the scene was drawn (window x right, y down)
} pc;

mat4 vp(vec4 a, vec4 b, vec4 c, vec4 d) { return transpose(mat4(a, b, c, d)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) return;

    float d = texelFetch(depth_tex, p, 0).r;
    vec2 win = vec2(p) + 0.5 - pc.jitter;   // where this pixel's surface sits without the jitter
    vec4 ndc = vec4(win.x / pc.size.x * 2.0 - 1.0, 1.0 - win.y / pc.size.y * 2.0, d * 2.0 - 1.0, 1.0);
    mat4 c = vp(cur.r[3], cur.r[4], cur.r[5], cur.r[6]);
    mat4 q = vp(prev.r[3], prev.r[4], prev.r[5], prev.r[6]);
    vec4 world = inverse(c) * ndc;
    vec2 mv = vec2(0.0);

    if (abs(world.w) > 1e-12) {
        vec4 clip = q * (world / world.w);
        if (clip.w > 1e-6) {
            vec2 pn = clip.xy / clip.w;
            vec2 pwin = vec2((pn.x * 0.5 + 0.5) * pc.size.x, (0.5 - pn.y * 0.5) * pc.size.y);
            vec2 cam_mv = pwin - win;
            mv = cam_mv;

            // Per-object dynamic actor tracking:
            // Compare expected reprojected depth against the actual previous-frame depth buffer.
            float expected_prev_d = (clip.z / clip.w) * 0.5 + 0.5;
            vec2 prev_uv = pwin / pc.size;

            if (prev_uv.x >= 0.0 && prev_uv.x <= 1.0 && prev_uv.y >= 0.0 && prev_uv.y <= 1.0) {
                float sampled_prev_d = textureLod(prev_depth_tex, prev_uv, 0.0).r;
                float depth_diff = abs(sampled_prev_d - expected_prev_d);

                // If depth differs significantly from rigid camera reprojection, this pixel is a moving dynamic object
                // (Link, enemies, weapons, projectiles). Search candidate velocity offsets in local neighborhood.
                if (depth_diff > 0.0015 && d < 0.9999) {
                    float best_err = depth_diff;
                    vec2 best_offset = vec2(0.0);

                    // Guided local search window (-3 to +3 pixels)
                    for (int dy = -3; dy <= 3; dy++) {
                        for (int dx = -3; dx <= 3; dx++) {
                            if (dx == 0 && dy == 0) continue;
                            vec2 test_uv = (pwin + vec2(float(dx), float(dy))) / pc.size;
                            if (test_uv.x >= 0.0 && test_uv.x <= 1.0 && test_uv.y >= 0.0 && test_uv.y <= 1.0) {
                                float test_d = textureLod(prev_depth_tex, test_uv, 0.0).r;
                                float err = abs(test_d - expected_prev_d);
                                if (err < best_err) {
                                    best_err = err;
                                    best_offset = vec2(float(dx), float(dy));
                                }
                            }
                        }
                    }

                    // Apply dynamic per-object motion offset to camera motion vector
                    mv += best_offset;
                }
            }
        }
    }

    imageStore(mv_out, p, vec4(mv, 0.0, 0.0));
}
